{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec turbo run build --filter=@turnopro/api",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{apps/api/dist,packages/database/dist,packages/database/prisma,packages/database/node_modules/.prisma/client,packages/database/node_modules/@prisma/client,packages/shared/dist,packages/contracts/dist}/**"
    }
  }
}
