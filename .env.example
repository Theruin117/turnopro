# ─────────────────────────────────────────────────────────────
# TurnoPro — variables de entorno de ejemplo
# Copia este archivo a .env y ejecuta `pnpm env:init` para
# generar los secretos. NUNCA commitees el archivo .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=debug

# API
PORT=3001
API_PREFIX=api/v1
SWAGGER_ENABLED=true
WEB_ORIGIN=http://localhost:3000

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://turnopro:turnopro@localhost:5432/turnopro?schema=public

# Redirects del frontend (varias URLs separadas por coma)
# API_PUBLIC_URL=https://turnopro-api.vercel.app

# Redis / BullMQ
# Opcional para la API: sin REDIS_URL, `/health/ready` reporta Redis como
# no configurado y el worker no puede ejecutarse en ese host.
REDIS_URL=redis://localhost:6379
WORKER_HEALTH_PORT=3002

# Autenticación
# `pnpm env:init` reemplaza los marcadores por secretos aleatorios.
JWT_ACCESS_SECRET=__GENERATED_SECRET__
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# COOKIE_DOMAIN=.turnopro.local

# Rate limiting (por IP, almacenamiento en memoria en esta etapa)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100

# Web (se inlinea en el bundle del cliente)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Seed local — datos ficticios, jamás credenciales reales
SEED_OWNER_EMAIL=owner@demo.turnopro.local
SEED_OWNER_PASSWORD=TurnoProDemo123!
SEED_ORG_SLUG=demo
SEED_ORG_NAME="TurnoPro Demo"
